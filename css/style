

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f8f9fd;
  color: #18243b;
}

.main-header {
  background: #18243b;
  color: white;
  padding: 3rem 1rem;
  text-align: center;
}

.site-title {
  animation: slideIn 0.8s ease-out;
}

.main-nav ul {
  display: flex;
  justify-content: center;
  gap: 15px;
  list-style: none;
  padding: 0;
}

.main-nav a {
  display: block;
  color: white;
  text-decoration: none;
  padding: 10px 16px;
  border-radius: 5px;
  transition: background-color 0.3s ease;
}

.main-nav a:hover {
  background: #6d5efc;
}

main {
  max-width: 1200px;
  margin: auto;
  padding: 30px;
}

section {
  margin-bottom: 40px;
  text-align: center;
}

.gallery-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 30px;
}

.image {
  background: #eef0fa;
  border: none;
  border-radius: 10px;
  min-height: 220px;
  font-size: 18px;
  font-weight: bold;
  color: #18243b;
  cursor: pointer;
  box-shadow: 0 4px 10px #0000001a;
  animation: fadeIn 1s ease-out;
  transition: transform 0.4s ease,
              background-color 0.3s ease;
}

.image:hover {
  transform: scale(1.05);
}

.image.active {
  background: #e7e4ff;
}

.main-footer {
  background: #18243b;
  color: white;
  text-align: center;
  padding: 20px;
}

@keyframes slideIn {
  from {
    transform: translateX(-100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes fadeIn {
  from {
    transform: scale(0.5);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

@media (max-width: 1023px) {
  .gallery-container {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 767px) {
  .gallery-container {
    grid-template-columns: 1fr;
  }

  .main-nav ul {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
  }
}
